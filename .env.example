# Провайдер LLM: gigachat (по умолчанию), openai (OpenAI-совместимый API / Ollama), mock (для оффлайн-проверки)
LLM_PROVIDER=gigachat

# === Настройки Sber GigaChat API ===
# Authorization Key из личного кабинета Studio (Base64 от ClientID:ClientSecret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Для физлиц (freemium) доступна модель GigaChat-3-Ultra (или GigaChat / GigaChat-2)
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_API_URL=https://api.giga.chat/v1/chat/completions
# В стандартных Linux-образах отсутствуют корневые сертификаты Минцифры РФ, поэтому по умолчанию false
# Для строгой проверки можно указать путь к сертификату в GIGACHAT_CA_BUNDLE
GIGACHAT_VERIFY_SSL=false
GIGACHAT_CA_BUNDLE=

# === Альтернативный OpenAI-совместимый провайдер (если LLM_PROVIDER=openai) ===
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Приватность и лимиты ===
# Обязательное обезличивание ПДн (ФИО, контакты, ссылки, адреса, возраст) перед отправкой во внешнее API
PII_REDACTION_ENABLED=true
MAX_FILE_SIZE_MB=10
# Для GIGACHAT_API_PERS (freemium) лимит — 1 параллельный поток (LLM_CONCURRENCY=1)
LLM_CONCURRENCY=1
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=90
